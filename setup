#!/usr/bin/env bash
# TechDraw AI skills, universal setup.
# Installs the skills for your agent and checks authentication.
set -euo pipefail

bold() { printf '\033[1m%s\033[0m\n' "$1"; }
ok()   { printf '  \033[32m✓\033[0m %s\n' "$1"; }
warn() { printf '  \033[33m!\033[0m %s\n' "$1"; }

bold "TechDraw AI skills setup"

# 1. Node check
if ! command -v node >/dev/null 2>&1; then
  warn "Node.js not found. Install Node 18+ from https://nodejs.org and re-run ./setup"
  exit 1
fi
ok "Node $(node -v)"

# 2. Install the skills cross-agent
if command -v npx >/dev/null 2>&1; then
  bold "Installing skills via npx skills..."
  npx -y skills add MeltFlexDevs/techdrawai-skills \
    || warn "npx skills failed. Try: gh skill install MeltFlexDevs/techdrawai-skills"
else
  warn "npx not found; install the skills manually (see INSTALL.md)"
fi

# 3. Auth check
if [ "${TECHDRAWAI_API_KEY:-}" = "" ]; then
  warn "TECHDRAWAI_API_KEY is not set."
  echo "    Sign in through your browser (nothing to copy or paste):"
  echo "      npx -y techdrawai-mcp auth login"
  echo "    Or create a key at https://techdrawai.com/app?view=settings and export it:"
  echo "      export TECHDRAWAI_API_KEY=\"tda_sk_...\""
  echo "    Programmatic access requires an active Studio plan."
else
  ok "TECHDRAWAI_API_KEY is set (${TECHDRAWAI_API_KEY:0:10}...)"
fi

bold "Done."
echo "Use /techdrawai:drafting or /techdrawai:cad in your agent."
echo "Docs: https://techdrawai.com/mcp"
